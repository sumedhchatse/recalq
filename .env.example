# Recalq settings — copy to .env (install.sh does this for you) and fill in.
# Only the keys for providers you enable in client.yaml are needed.

# ── LLM provider keys (names match api_key_env in client.yaml) ──
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_FLASH_API_KEY=
NVIDIA_MODEL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
KIMI_K3_API_KEY=

# ── Redis (install.sh generates a random password) ──
REDIS_PASSWORD=
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── Telegram bot (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ── Team ──
# Comma-separated OS logins / Telegram ids who see everyone's /usage and can /approve.
RECALQ_ADMINS=
# Monthly $ cap per person; over it they only get free models. Empty = no cap.
RECALQ_BUDGET_USD=

# ── Agent ──
# podman or docker: run /agent shell commands in a no-network container.
AGENT_SANDBOX=
# AGENT_SANDBOX_IMAGE=docker.io/library/python:3.12-slim
# AGENT_AUTO_ALLOW=pytest*,python3 test_*
# AGENT_WEB_FETCH=0
# RECALQ_PR_PUSH=1

# ── Tuning (defaults are fine) ──
# CACHE_TTL=31536000
# SIMILARITY_CUTOFF=0.78
# LLM_REQUEST_TIMEOUT=30   # 90 suits reasoning models (e.g. nemotron) on /agent tasks
# PROVIDER_COOLDOWN=300
# PROVIDER_MAX_ATTEMPTS=3
# RECALQ_LOG=~/.recalq/memlayer.log
